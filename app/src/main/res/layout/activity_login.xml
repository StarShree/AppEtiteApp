<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero Brand Header with Culinary Violet Gradient -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_login_header"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="28dp"
                android:paddingEnd="20dp"
                android:paddingBottom="40dp">

                <!-- Top Status & Theme Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Cloud SQL Status Pill with glowing indicator -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_hero_pill"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="6dp">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_indicator_dot" />

                        <TextView
                            android:id="@+id/tvDbStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="🟢 MySQL: 34.100.184.249:3306"
                            android:textColor="@color/white"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Theme Toggle Button -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnThemeToggleLogin"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="10dp"
                        app:cardBackgroundColor="#33FFFFFF"
                        app:cardCornerRadius="19dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#55FFFFFF"
                        app:strokeWidth="1dp">

                        <ImageView
                            android:id="@+id/ivThemeIconLogin"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="Toggle Light/Dark Theme"
                            android:src="@drawable/ic_dark_mode"
                            app:tint="@color/white" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Logo in stylish frosted circular frame -->
                <FrameLayout
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:background="@drawable/bg_logo_circle"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="AppEtite Logo"
                        android:src="@drawable/ic_launcher_foreground" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.02"
                    android:text="AppEtite"
                    android:textColor="@color/white"
                    android:textSize="30sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Smart Campus Dining &amp; Instant Pickups"
                    android:textColor="#FFE0D6"
                    android:textSize="13sp" />

                <!-- 3 Quick Value Highlights -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <!-- Pill 1: Fast -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_hero_pill"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:contentDescription="Fast icon"
                            android:src="@drawable/ic_bolt" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="Zero Lines"
                            android:textColor="@color/white"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <!-- Pill 2: Live Token -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_hero_pill"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:contentDescription="Token icon"
                            android:src="@drawable/ic_token_badge"
                            app:tint="#FFD54F" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="Live Tokens"
                            android:textColor="@color/white"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <!-- Pill 3: Pickup PIN -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_hero_pill"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:contentDescription="PIN icon"
                            android:src="@drawable/ic_key_pin"
                            app:tint="#FFD54F" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="Secure PIN"
                            android:textColor="@color/white"
                            android:textSize="10.5sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Floating Material Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="-24dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="24dp"
                app:cardElevation="6dp"
                app:strokeColor="@color/outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="Welcome Back"
                        android:textColor="@color/on_surface"
                        android:textSize="21sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Select your role to access your dedicated campus workspace"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12.5sp" />

                    <!-- Dedicated Portal Switch: Campus User vs Staff/Admin -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_portal_toggle"
                        android:orientation="horizontal"
                        android:padding="4dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSwitchStudent"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-bold"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="🎓 Campus User Portal"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="12.5sp"
                            app:backgroundTint="@color/primary"
                            app:cornerRadius="10dp"
                            app:elevation="2dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSwitchStaff"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="🛡️ Staff &amp; Admin"
                            android:textAllCaps="false"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="12.5sp"
                            app:backgroundTint="@android:color/transparent"
                            app:cornerRadius="10dp" />
                    </LinearLayout>

                    <!-- Staff Sub-Role Selector (Only visible in Staff & Admin mode) -->
                    <LinearLayout
                        android:id="@+id/layoutStaffRoles"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="Select Institutional Role"
                            android:textColor="@color/on_surface"
                            android:textSize="12.5sp" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:scrollbars="none">

                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/chipGroupRoles"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:selectionRequired="true"
                                app:singleSelection="true">

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipKitchen"
                                    style="@style/Widget.AppEtite.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:checked="true"
                                    android:text="👨‍🍳 Canteen Staff" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipCollegeAdmin"
                                    style="@style/Widget.AppEtite.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="🏛️ College Admin" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipSuperAdmin"
                                    style="@style/Widget.AppEtite.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="⚡ Super Admin" />
                            </com.google.android.material.chip.ChipGroup>
                        </HorizontalScrollView>

                        <!-- Staff Institution & Canteen Assignment Section -->
                        <LinearLayout
                            android:id="@+id/layoutStaffInstitution"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical"
                            android:visibility="visible">

                            <!-- 1. College Institution Selection Field -->
                            <TextView
                                android:id="@+id/tvLabelLoginCollege"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="College / Institution *"
                                android:textColor="@color/on_surface"
                                android:textSize="12.5sp" />

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardLoginCollegePicker"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardBackgroundColor="@color/surface_variant"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp"
                                app:strokeColor="@color/outline"
                                app:strokeWidth="1.2dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingStart="12dp"
                                    android:paddingTop="10dp"
                                    android:paddingEnd="12dp"
                                    android:paddingBottom="10dp">

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:contentDescription="College"
                                        android:src="@drawable/ic_school"
                                        app:tint="@color/primary" />

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="10dp"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <TextView
                                            android:id="@+id/tvLoginSelectedCollegeName"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:fontFamily="sans-serif-bold"
                                            android:text="Stanford University Campus"
                                            android:textColor="@color/on_surface"
                                            android:textSize="13.5sp" />

                                        <TextView
                                            android:id="@+id/tvLoginSelectedCollegeSub"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="1dp"
                                            android:text="Main Campus, Building A"
                                            android:textColor="@color/on_surface_variant"
                                            android:textSize="11sp" />
                                    </LinearLayout>

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:contentDescription="Dropdown"
                                        android:src="@drawable/ic_arrow_drop_down"
                                        app:tint="@color/primary" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <!-- 2. Canteen Selection Field (For Canteen Staff) -->
                            <LinearLayout
                                android:id="@+id/layoutLoginCanteenContainer"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvLabelLoginCanteen"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium"
                                    android:text="Assigned Canteen Stall *"
                                    android:textColor="@color/on_surface"
                                    android:textSize="12.5sp" />

                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/cardLoginCanteenPicker"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:clickable="true"
                                    android:focusable="true"
                                    app:cardBackgroundColor="@color/surface_variant"
                                    app:cardCornerRadius="12dp"
                                    app:cardElevation="0dp"
                                    app:strokeColor="@color/outline"
                                    app:strokeWidth="1.2dp">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal"
                                        android:paddingStart="12dp"
                                        android:paddingTop="10dp"
                                        android:paddingEnd="12dp"
                                        android:paddingBottom="10dp">

                                        <ImageView
                                            android:layout_width="20dp"
                                            android:layout_height="20dp"
                                            android:contentDescription="Canteen"
                                            android:src="@drawable/ic_restaurant"
                                            app:tint="@color/primary" />

                                        <LinearLayout
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="10dp"
                                            android:layout_weight="1"
                                            android:orientation="vertical">

                                            <TextView
                                                android:id="@+id/tvLoginSelectedCanteenName"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:fontFamily="sans-serif-bold"
                                                android:text="Byte Bites Canteen (Engineering Block)"
                                                android:textColor="@color/on_surface"
                                                android:textSize="13.5sp" />

                                            <TextView
                                                android:id="@+id/tvLoginSelectedCanteenSub"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginTop="1dp"
                                                android:text="Ground Floor, Engineering Wing"
                                                android:textColor="@color/on_surface_variant"
                                                android:textSize="11sp" />
                                        </LinearLayout>

                                        <ImageView
                                            android:layout_width="20dp"
                                            android:layout_height="20dp"
                                            android:contentDescription="Dropdown"
                                            android:src="@drawable/ic_arrow_drop_down"
                                            app:tint="@color/primary" />
                                    </LinearLayout>
                                </com.google.android.material.card.MaterialCardView>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Role Context Information Banner -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_status_badge"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:id="@+id/tvRoleHint"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="Ordering food across campus canteens"
                            android:textColor="@color/on_primary_container"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnQuickFill"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:text="Demo Fill"
                            android:textColor="@color/primary"
                            android:textSize="11.5sp"
                            app:backgroundTint="@color/white"
                            app:cornerRadius="10dp" />
                    </LinearLayout>

                    <!-- 1-Tap Demo Switcher Pills -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="1-Tap Demo Accounts"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="11.5sp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- Campus User Demo Pill (Visible in Campus User mode) -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDemoStudent"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:paddingStart="10dp"
                                android:paddingTop="4dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="4dp"
                                android:text="🎓 Alex (Campus User)"
                                android:textColor="@color/on_surface"
                                android:textSize="11sp"
                                app:cornerRadius="12dp"
                                app:strokeColor="@color/outline" />

                            <!-- Staff Demo Pills (Visible in Staff mode) -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDemoKitchen"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:paddingStart="10dp"
                                android:paddingTop="4dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="4dp"
                                android:text="👨‍🍳 Roberto (Canteen Staff)"
                                android:textColor="@color/on_surface"
                                android:textSize="11sp"
                                app:cornerRadius="12dp"
                                app:strokeColor="@color/outline" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDemoCollege"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:paddingStart="10dp"
                                android:paddingTop="4dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="4dp"
                                android:text="🏛️ Dean (College Admin)"
                                android:textColor="@color/on_surface"
                                android:textSize="11sp"
                                app:cornerRadius="12dp"
                                app:strokeColor="@color/outline" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDemoSuper"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:paddingStart="10dp"
                                android:paddingTop="4dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="4dp"
                                android:text="⚡ Sarah (Super Admin)"
                                android:textColor="@color/on_surface"
                                android:textSize="11sp"
                                app:cornerRadius="12dp"
                                app:strokeColor="@color/outline" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <!-- Email Input with Start Icon -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilEmail"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="Email Address"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/primary"
                        app:hintTextColor="@color/primary"
                        app:startIconDrawable="@drawable/ic_mail"
                        app:startIconTint="@color/primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress"
                            android:maxLines="1"
                            android:text="alex.rivera@campus.edu"
                            android:textColor="@color/on_surface"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Password Input with Start Icon & End Toggle -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPassword"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Password"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/primary"
                        app:endIconMode="password_toggle"
                        app:hintTextColor="@color/primary"
                        app:startIconDrawable="@drawable/ic_lock"
                        app:startIconTint="@color/primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:text="Student@123"
                            android:textColor="@color/on_surface"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Sign In Primary Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLogin"
                        style="@style/Widget.AppEtite.Button"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="20dp"
                        android:backgroundTint="@color/primary"
                        android:elevation="4dp"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.02"
                        android:text="Sign In to AppEtite"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="15.5sp"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_arrow_forward"
                        app:iconGravity="textEnd"
                        app:iconPadding="8dp"
                        app:iconTint="@color/white" />

                    <!-- Loading Indicator -->
                    <ProgressBar
                        android:id="@+id/progressBarLogin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="12dp"
                        android:indeterminateTint="@color/primary"
                        android:visibility="gone" />

                    <!-- Customer Register Prompt (Exclusively for Students) -->
                    <LinearLayout
                        android:id="@+id/layoutCustomerRegister"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="New to campus dining? "
                            android:textColor="@color/on_surface_variant"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvRegisterLink"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="Register Campus User Account"
                            android:textColor="@color/primary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Staff & Admin Security Notice Card (Strictly login-only, no registration) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardStaffNotice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardBackgroundColor="#FFF0EB"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#FFCCBC"
                        app:strokeWidth="1dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="12dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:contentDescription="Security badge"
                                android:src="@drawable/ic_shield_check"
                                app:tint="@color/primary" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-bold"
                                    android:text="Restricted Staff Access Only"
                                    android:textColor="@color/primary"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tvStaffNotice"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:lineSpacingExtra="1.5dp"
                                    android:text="Registration is disabled for Super Admin, College Admin, and Canteen Staff. These accounts are provisioned directly by the campus system administrator."
                                    android:textColor="#8D2B0B"
                                    android:textSize="11.5sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bottom Institutional Trust Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Security badge"
                    android:src="@drawable/ic_shield_check"
                    app:tint="@color/on_surface_variant" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Powered by Google Cloud SQL • Multi-Campus Canteen Network"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="11.5sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
